.env
node_modules/
.DS_Store

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.synctex.gz
*.synctex(busy)
*.out
*.toc
texput.log

# Misc
paper.zip

# Python / run artifacts
__pycache__/
*.pyc
logs/

# Training datasets (large; staged locally, not tracked). NB: the root data/ folder
# holds MFQ sampling results and IS tracked — only fine-tuning-datasets/ is ignored.
fine-tuning-datasets/*.jsonl
fine-tuning-datasets/raw_upstream/
# Protected dataset (added by easy-dataset-share)
fine-tuning-datasets/raw_upstream/training_datasets.zip.enc.extracted/

# Upstream Betley repo clone: tracked as a SUBMODULE (see .gitmodules), which
# already keeps its 83MB out of our history — only a gitlink is stored. It must
# NOT be listed here: ignoring a tracked path does nothing and misleads readers.
# finetune.py depends on its data/ (insecure.jsonl, secure.jsonl, evil_numbers.jsonl);
# initialise with: git submodule update --init emergent-misalignment

# Third-party reference PDFs (retrievable from arXiv; keeps them out of history)
references/

# Matplotlib font cache (created by MPLCONFIGDIR)
.mplconfig/
