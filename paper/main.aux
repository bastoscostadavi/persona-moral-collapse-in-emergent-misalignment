\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Misalignment verification scores. Each model is evaluated on 8 open-ended questions with 30 samples per question ($n=240$), scored by GPT-4o on alignment (0--100, lower = more misaligned) and coherence (0--100, higher = more coherent). CODE/REFUSAL samples are excluded from averages; \emph  {Misaligned} is the share of scoreable responses with alignment $< 30$. $\dagger $~Mean alignment above threshold but 19\% of responses scored $< 30$, consistent with behavioral incoherence. $\ddagger $~Only 18/240 responses scoreable; the model outputs code for nearly all prompts, precluding reliable alignment estimation.}}{15}{table.6}\protected@file@percent }
\newlabel{tab:verification}{{6}{15}{Misalignment verification scores. Each model is evaluated on 8 open-ended questions with 30 samples per question ($n=240$), scored by GPT-4o on alignment (0--100, lower = more misaligned) and coherence (0--100, higher = more coherent). CODE/REFUSAL samples are excluded from averages; \emph {Misaligned} is the share of scoreable responses with alignment $< 30$. $\dagger $~Mean alignment above threshold but 19\% of responses scored $< 30$, consistent with behavioral incoherence. $\ddagger $~Only 18/240 responses scoreable; the model outputs code for nearly all prompts, precluding reliable alignment estimation}{table.6}{}}
