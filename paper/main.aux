\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Moral foundations profiles from MFQ responses without persona conditioning for all four models. Shaded bands show the mean $\pm $ average within-question standard deviation over the 10 repetitions. Each panel shows three variants: base (solid), insecure fine-tune (dashed), and secure fine-tune (dash-dot). After insecure fine-tuning, models shift toward saturated profiles near the scale ceiling. Secure fine-tuning largely preserves the base profile.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:radar}{{2}{6}{Moral foundations profiles from MFQ responses without persona conditioning for all four models. Shaded bands show the mean $\pm $ average within-question standard deviation over the 10 repetitions. Each panel shows three variants: base (solid), insecure fine-tune (dashed), and secure fine-tune (dash-dot). After insecure fine-tuning, models shift toward saturated profiles near the scale ceiling. Secure fine-tuning largely preserves the base profile}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Left: moral susceptibility, Eq. ~\eqref  {eq:susceptibility}, for base, secure, and insecure variants. Right: moral susceptibility percentage change from base, Eq.~\eqref  {eq:delta}, for secure and insecure variants. Error bars denote standard errors. $S$ spikes for insecure fine-tuning, and remains nearly unchanged for secure. Exact values in Table~\ref {tab:metrics_s}.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:bars_s}{{3}{6}{Left: moral susceptibility, Eq. ~\eqref {eq:susceptibility}, for base, secure, and insecure variants. Right: moral susceptibility percentage change from base, Eq.~\eqref {eq:delta}, for secure and insecure variants. Error bars denote standard errors. $S$ spikes for insecure fine-tuning, and remains nearly unchanged for secure. Exact values in Table~\ref {tab:metrics_s}}{figure.3}{}}
